# Copiar para .env e preencher os valores reais
# cp .env.example .env

# Obrigatório — gerar com: openssl rand -base64 48
JWT_SECRET=

# Origens permitidas pelo CORS (separadas por vírgula, sem espaços)
# Exemplo: https://nanter.app,https://www.nanter.app
ALLOWED_ORIGINS=https://teu-dominio.com

# Porta onde o servidor Node escuta (default: 3000)
PORT=3000

# Password do Postgres (o compose usa esta var em ambos os serviços)
POSTGRES_PASSWORD=escolhe-uma-password-forte
